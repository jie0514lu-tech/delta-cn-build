+// MARK: - Language
+
+private struct LanguageSection: View
+{
+    @ObservedObject
+    private var languageManager: LanguageManager = .shared
+
+    @SwiftUI.State
+    private var didChangeLanguage = false
+
+    var body: some View {
+        Section {
+            Picker(selection: Binding(get: {
+                languageManager.language
+            }, set: { newLanguage in
+                guard newLanguage != languageManager.language else { return }
+
+                languageManager.select(newLanguage)
+                didChangeLanguage = true
+            })) {
+                ForEach(DeltaLanguage.allCases) { language in
+                    Text(language.displayName).tag(language)
+                }
+            } label: {
+                Label {
+                    Text("Language")
+                } icon: {
+                    Image(systemName: "globe")
+                }
+            }
+            .pickerStyle(.menu)
+        } footer: {
+            Text("Restart Delta to apply the new language everywhere.")
+        }
+        .alert("Language Changed", isPresented: $didChangeLanguage) {
+            Button("OK", role: .cancel) {}
+        } message: {
+            Text("Please restart Delta to apply the new language.")
+        }
+    }
+}
+
